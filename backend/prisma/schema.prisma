datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP_LOSS
}

enum OrderStatus {
  PENDING
  FILLED
  CANCELLED
  REJECTED
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String         @map("password_hash")
  fullName     String         @map("full_name")
  refreshToken String?        @map("refresh_token")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  portfolios   Portfolio[]
  orders       Order[]
  trades       Trade[]
  watchlists   Watchlist[]
  journal      JournalEntry[]

  @@map("users")
}

model Portfolio {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  accountName   String        @default("Primary INR Paper Portfolio") @map("account_name")
  cashBalance   Decimal       @default(1000000.00) @map("cash_balance") @db.Decimal(15, 2)
  currency      String        @default("INR")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  positions     Position[]
  ledgerEntries LedgerEntry[]

  @@map("portfolios")
}

model Order {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  portfolioId    String        @map("portfolio_id")
  symbol         String        @db.VarChar(20)
  side           OrderSide
  orderType      OrderType     @map("order_type")
  status         OrderStatus   @default(PENDING)
  quantity       Decimal       @db.Decimal(12, 4)
  filledQuantity Decimal       @default(0.0) @map("filled_quantity") @db.Decimal(12, 4)
  price          Decimal?      @db.Decimal(12, 4)
  avgFillPrice   Decimal?      @map("avg_fill_price") @db.Decimal(12, 4)
  totalCost      Decimal?      @map("total_cost") @db.Decimal(15, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio      Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  trades         Trade[]
  ledgerEntries  LedgerEntry[]

  @@map("orders")
}

model Trade {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  userId     String   @map("user_id")
  symbol     String   @db.VarChar(20)
  side       String   @db.VarChar(10)
  quantity   Decimal  @db.Decimal(12, 4)
  price      Decimal  @db.Decimal(12, 4)
  fee        Decimal  @default(0.00) @db.Decimal(10, 2)
  executedAt DateTime @default(now()) @map("executed_at")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trades")
}

model Position {
  id            String    @id @default(uuid())
  portfolioId   String    @map("portfolio_id")
  symbol        String    @db.VarChar(20)
  quantity      Decimal   @default(0.0) @db.Decimal(12, 4)
  avgEntryPrice Decimal   @map("avg_entry_price") @db.Decimal(12, 4)
  updatedAt     DateTime  @updatedAt @map("updated_at")
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbol])
  @@map("positions")
}

model LedgerEntry {
  id           String    @id @default(uuid())
  portfolioId  String    @map("portfolio_id")
  orderId      String?   @map("order_id")
  entryType    String    @map("entry_type") @db.VarChar(50)
  amount       Decimal   @db.Decimal(15, 2)
  balanceAfter Decimal   @map("balance_after") @db.Decimal(15, 2)
  description  String?
  referenceId  String?   @map("reference_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("ledger")
}

model Watchlist {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String   @db.VarChar(100)
  description String?
  symbols     String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("watchlists")
}

model JournalEntry {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  symbol         String   @db.VarChar(20)
  tradeType      String   @map("trade_type") @db.VarChar(10)
  entryPrice     Decimal  @map("entry_price") @db.Decimal(12, 4)
  exitPrice      Decimal? @map("exit_price") @db.Decimal(12, 4)
  quantity       Decimal  @db.Decimal(12, 4)
  setupTag       String   @map("setup_tag") @db.VarChar(50)
  notes          String   @db.Text
  emotionalState String   @map("emotional_state") @db.VarChar(30)
  rating         Int      @default(4)
  pnl            Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journal_entries")
}
